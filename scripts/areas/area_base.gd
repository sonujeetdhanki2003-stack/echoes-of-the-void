class_name Area
extends Node3D
## Base for the six areas (PRD "Maps"). Subclasses override build() to lay out rooms with the LevelBuilder,
## place props, interactables, enemies, triggers and checkpoints; the base supplies the environment, lights,
## navigation and quality handling.

var area_id := ""
var theme_id := ""
var theme: Dictionary
var B: LevelBuilder
var env: Environment
var world_env: WorldEnvironment
var sun: DirectionalLight3D
var nav: NavigationRegion3D
var checkpoints := {}          # id -> Transform3D
var tension := false           # music: tension bed instead of exploration
var _lights: Array = []        # [OmniLight3D/SpotLight3D, wants_shadow]
var _probes: Array = []
var _flicker: Array = []
var _t := 0.0

func _init() -> void:
	add_to_group("area")

var _seed := 11
var dress_stats := {}

func setup_theme(id: String, seed_value: int = 11) -> void:
	theme_id = id
	_seed = seed_value
	theme = Themes.get_theme(id)
	B = LevelBuilder.new(self, theme, seed_value)
	_make_env()
	nav = NavigationRegion3D.new()
	nav.name = "Nav"
	var nm := NavigationMesh.new()
	nm.agent_radius = 0.5
	nm.agent_height = 1.8
	nm.agent_max_climb = 0.4
	nm.agent_max_slope = 40.0
	nm.cell_size = 0.25
	nm.cell_height = 0.2
	nm.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
	nm.geometry_source_geometry_mode = NavigationMesh.SOURCE_GEOMETRY_GROUPS_WITH_CHILDREN
	nm.geometry_source_group_name = &"nav_source"
	nm.geometry_collision_mask = 1
	nav.navigation_mesh = nm
	add_child(nav)
	var rv: Array = theme.get("reverb", [0.5, 0.14])
	Sfx.set_space(rv[0], rv[1])

func build() -> void:
	pass

## Visibility ranges (Post-PRD Phase 10, "LODs/visibility ranges"): small clutter stops drawing beyond a
## distance with a short fade; mesh LODs themselves are generated by Godot's importer for every glTF mesh.
func apply_visibility_ranges() -> void:
	var outdoor := theme_id in ["exterior", "extraction"]
	for gi in find_children("*", "GeometryInstance3D", true, false):
		var g := gi as GeometryInstance3D
		if g.visibility_range_end > 0.0 or g.layers & 2 or g is Label3D:
			continue
		var aabb := AABB()
		if g is MeshInstance3D and (g as MeshInstance3D).mesh:
			aabb = (g as MeshInstance3D).mesh.get_aabb()
		elif g is MultiMeshInstance3D:
			continue   # kit batches span whole areas
		else:
			continue
		var sz := aabb.size * g.global_transform.basis.get_scale()
		var big := maxf(sz.x, maxf(sz.y, sz.z))
		var q: Node = g
		var actor := false
		while q and q != self:
			if q is CharacterBody3D or q.is_in_group("boss"):
				actor = true
				break
			q = q.get_parent()
		if actor:
			continue
		var end := 0.0
		if big < 0.6:
			end = 55.0 if outdoor else 30.0
		elif big < 2.5:
			end = 140.0 if outdoor else 60.0
		if end > 0.0:
			g.visibility_range_end = end
			g.visibility_range_end_margin = end * 0.12
			g.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF

## M2 realism: grime/leak overlay on every static mesh of an interior (see shaders/grime_overlay.gdshader).
static var _grime_noise: NoiseTexture2D
## Wall/ceiling dressing models and decals on the faces the LevelBuilder recorded (scripts/world/dressing.gd).
func apply_dressing() -> void:
	if B == null or B.wall_edges.is_empty():
		return
	dress_stats = Dressing.dress(self, B, theme_id, _seed)
	B._flush()

func apply_grime() -> void:
	if not theme.has("grime"):
		return
	if str(Game.settings.get("quality", "high")) == "low" or Game.has_arg("nogrime") or (Game.is_mobile and RenderingServer.get_current_rendering_method() == "gl_compatibility"):   # phones on the web build: the overlay doubles draw calls
		return
	if _grime_noise == null:
		var fn := FastNoiseLite.new()
		fn.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
		fn.frequency = 0.012
		fn.fractal_octaves = 4
		_grime_noise = NoiseTexture2D.new()
		_grime_noise.width = 512
		_grime_noise.height = 512
		_grime_noise.seamless = true
		_grime_noise.noise = fn
		_grime_noise.generate_mipmaps = true
	var compat := RenderingServer.get_current_rendering_method() == "gl_compatibility"
	var mat := ShaderMaterial.new()
	mat.shader = load("res://shaders/grime_overlay_compat.gdshader" if RenderingServer.get_current_rendering_method() == "gl_compatibility" else "res://shaders/grime_overlay.gdshader")
	mat.set_shader_parameter("noise", _grime_noise)
	mat.set_shader_parameter("strength", float(Game.arg("grime", str(theme["grime"]))))
	mat.set_shader_parameter("tint", theme.get("grime_tint", Color(0.62, 0.56, 0.5)))
	var n := 0
	for mi in find_children("*", "GeometryInstance3D", true, false):
		var m := mi as GeometryInstance3D
		var mesh: Mesh = null
		if m is MeshInstance3D:
			mesh = (m as MeshInstance3D).mesh
		elif m is MultiMeshInstance3D and (m as MultiMeshInstance3D).multimesh:
			mesh = (m as MultiMeshInstance3D).multimesh.mesh
		if mesh == null or m.material_overlay != null or m.layers & 2:
			continue
		var skip := false
		var q: Node = m
		while q and q != self:
			if q.is_in_group("actor") or q.is_in_group("pickup") or q.is_in_group("enemy") or q is CharacterBody3D:
				skip = true
				break
			q = q.get_parent()
		if skip:
			continue
		var sz := mesh.get_aabb().size
		var big_edge := maxf(sz.x, maxf(sz.y, sz.z))
		if big_edge < 0.45:
			continue
		# the web build (Compatibility renderer) pays the overlay as a second draw call per mesh: only the large surfaces
		# (kit walls/floors, big machinery) get it there, which is where the dirt reads from a distance anyway
		if compat and big_edge < 2.5 and not (m is MultiMeshInstance3D):
			continue
		var mat0: Material = (m as MeshInstance3D).get_active_material(0) if m is MeshInstance3D else (m.material_override if m.material_override else mesh.surface_get_material(0))
		if mat0 is BaseMaterial3D and ((mat0 as BaseMaterial3D).transparency != BaseMaterial3D.TRANSPARENCY_DISABLED or (mat0 as BaseMaterial3D).emission_enabled and (mat0 as BaseMaterial3D).emission_energy_multiplier > 1.5):
			continue
		m.material_overlay = mat
		n += 1
	if OS.is_debug_build() and Game.has_arg("verbose"):
		print("grime overlay on ", n, " meshes in ", area_id)

## Called once the player is placed. fresh = arriving for the first time this playthrough.
func on_enter(_fresh: bool) -> void:
	Sfx.area_music = theme.get("music", "music_explore")
	Sfx.music_mode = ""
	Sfx.ambience(theme.get("amb", ""), -2.0)
	var pl = GameMode.player
	if pl and pl.controller:
		pl.controller.set_rim_tint(theme.get("light_color", Color(0.7, 0.85, 1.0)), float(theme.get("rim", 1.4)))

# ---------------------------------------------------------------- environment
func _make_env() -> void:
	var e: Dictionary = theme["env"]
	env = Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = e["bg"]
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = e["ambient"]
	env.ambient_light_energy = e["ambient_energy"]
	env.tonemap_mode = Environment.TONE_MAPPER_AGX
	env.tonemap_exposure = e["exposure"] * float(theme.get("exposure_mult", 1.15))
	env.tonemap_white = 6.0
	env.glow_enabled = true
	env.glow_intensity = e["glow"] * 0.7
	env.glow_strength = 0.9
	env.glow_bloom = 0.04
	env.glow_hdr_threshold = 0.95
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT
	env.set_glow_level(0, 0.0)
	env.set_glow_level(1, 0.6)
	env.set_glow_level(2, 0.9)
	env.set_glow_level(3, 1.0)
	env.set_glow_level(4, 0.6)
	env.adjustment_enabled = true
	env.adjustment_contrast = e["contrast"]
	env.adjustment_saturation = e["saturation"]
	env.adjustment_brightness = 1.0
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_EXPONENTIAL
	env.fog_light_color = (e["fog_color"] as Color) * float(e.get("fog_light", 0.5))
	env.fog_density = e["fog_density"] * 0.25
	env.fog_sky_affect = 0.6
	env.volumetric_fog_density = e["fog_density"]
	env.volumetric_fog_albedo = e["fog_color"]
	env.volumetric_fog_emission = e["fog_emission"]
	env.volumetric_fog_emission_energy = 1.0
	env.volumetric_fog_anisotropy = 0.55
	env.volumetric_fog_length = 64.0
	env.volumetric_fog_detail_spread = 2.0
	env.volumetric_fog_gi_inject = 0.6
	env.volumetric_fog_temporal_reprojection_enabled = true
	env.ssao_radius = 1.2
	env.ssao_intensity = 2.2
	env.ssao_power = 1.6
	env.ssao_light_affect = 0.15
	env.ssil_radius = 4.0
	env.ssil_intensity = 0.8
	env.sdfgi_use_occlusion = true
	env.sdfgi_cascades = 4
	env.sdfgi_min_cell_size = 0.2
	env.sdfgi_energy = 0.9
	env.sdfgi_bounce_feedback = 0.4
	env.ssr_max_steps = 48
	world_env = WorldEnvironment.new()
	world_env.environment = env
	add_child(world_env)

## Quality presets (Game.quality_profile) flip the expensive features on/off live.
func apply_quality(p: Dictionary) -> void:
	if env == null:
		return
	env.sdfgi_enabled = p["sdfgi"]
	env.ssao_enabled = p["ssao"]
	env.ssil_enabled = p["ssil"]
	env.ssr_enabled = p["ssr"]
	env.volumetric_fog_enabled = p["vol_fog"]
	env.glow_enabled = p["glow"]
	var e: Dictionary = theme["env"]
	# the Compatibility renderer has no HDR buffer: nothing exceeds 1.0, so the glow threshold is lowered to keep the bloom
	env.glow_hdr_threshold = 0.95
	# without SDFGI there is no bounce light: lift the ambient so interiors don't fall to black on Mobile/Low
	if env.ambient_light_source == Environment.AMBIENT_SOURCE_COLOR:
		env.ambient_light_energy = float(e["ambient_energy"]) * (1.0 if p["sdfgi"] else float(p.get("ambient_boost", 1.6)))
	# without volumetric fog, thicken the cheap distance fog so depth still reads
	env.fog_density = e["fog_density"] * (0.25 if p["vol_fog"] else 0.6)
	if sun:
		sun.shadow_enabled = p["shadows"]
		sun.directional_shadow_max_distance = 60.0 if p["shadow_size"] >= 4096 else float(p.get("shadow_dist", 40.0))
		# every shadow split re-draws the scene's geometry into the shadow map: phones and "low" use 2 splits
		sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS if int(p.get("splits", 4)) == 2 else DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	RenderingServer.directional_shadow_atlas_set_size(int(p["shadow_size"]), true)
	for pair in _lights:
		var l: Light3D = pair[0]
		if is_instance_valid(l):
			l.shadow_enabled = bool(pair[1]) and bool(p["lights_shadow"])
	for pr in _probes:
		if is_instance_valid(pr):
			(pr as ReflectionProbe).visible = bool(p.get("probes", p["ssao"]))
	# mesh LOD: lower presets switch to simplified meshes sooner (threshold in pixels; default 1.0)
	get_viewport().mesh_lod_threshold = 1.0 / maxf(float(p["lod_bias"]), 0.1)
	var cam := get_viewport().get_camera_3d()
	if cam:
		cam.far = p["far"]

func make_sun(dir_deg: Vector3, color: Color, energy: float, shadows: bool = true) -> DirectionalLight3D:
	sun = DirectionalLight3D.new()
	sun.rotation_degrees = dir_deg
	sun.light_color = color
	sun.light_energy = energy
	sun.shadow_enabled = shadows
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 60.0
	sun.light_volumetric_fog_energy = 1.5
	add_child(sun)
	return sun

# ---------------------------------------------------------------- lights
func omni(pos: Vector3, color: Color, energy: float = 1.5, rng: float = 9.0, shadow: bool = false, flicker: float = 0.0) -> OmniLight3D:
	var l := OmniLight3D.new()
	l.light_color = color
	l.light_energy = energy
	l.omni_range = rng
	l.omni_attenuation = 1.2
	l.light_volumetric_fog_energy = 1.2
	l.shadow_enabled = shadow
	l.distance_fade_enabled = true
	l.distance_fade_begin = 45.0
	l.distance_fade_length = 15.0
	l.distance_fade_shadow = 22.0     # far lights stop casting shadows first (shadow passes are the big cost)
	add_child(l)
	l.position = pos
	_lights.append([l, shadow])
	if flicker > 0.0:
		_flicker.append([l, energy, flicker, randf() * 10.0])
	return l

func spot(pos: Vector3, target: Vector3, color: Color, energy: float = 3.0, rng: float = 14.0, angle: float = 40.0, shadow: bool = true) -> SpotLight3D:
	var l := SpotLight3D.new()
	l.light_color = color
	l.light_energy = energy
	l.spot_range = rng
	l.spot_angle = angle
	l.spot_angle_attenuation = 1.4
	l.shadow_enabled = shadow
	l.light_volumetric_fog_energy = 2.0
	l.distance_fade_enabled = true
	l.distance_fade_begin = 50.0
	l.distance_fade_length = 15.0
	l.distance_fade_shadow = 28.0
	add_child(l)
	l.position = pos
	if pos.distance_to(target) > 0.01:
		var up := Vector3.UP if absf((target - pos).normalized().dot(Vector3.UP)) < 0.95 else Vector3.FORWARD
		l.look_at(target, up)
	_lights.append([l, shadow])
	return l

## Ceiling lights for a room: one omni per `every` cells along the ceiling (the kit strips glow on their own).
func room_lights(room_id: String, every: int = 2, energy_mult: float = 1.0, shadow_first: bool = true, flicker: float = 0.0) -> void:
	var r: Dictionary = B.rooms[room_id]
	if not r["lights"]:
		return
	var h: float = r["h"] * LevelBuilder.CELL
	var first := true
	for i in range(0, r["w"], every):
		for j in range(0, r["d"], every):
			var cx: float = r["x"] + mini(i + every / 2, r["w"] - 1) + (0.5 if every == 1 else 0.0)
			var cz: float = r["z"] + mini(j + every / 2, r["d"] - 1) + (0.5 if every == 1 else 0.0)
			if every > 1:
				cx = r["x"] + i + minf(every, r["w"] - i) * 0.5
				cz = r["z"] + j + minf(every, r["d"] - j) * 0.5
			var p := Vector3(cx * LevelBuilder.CELL, r["y"] + h - 0.6, cz * LevelBuilder.CELL)
			var ol := omni(p, r["light_color"], 2.3 * r["light_energy"] * energy_mult, 9.0 + every * 2.5, shadow_first and first, flicker)
			ol.omni_attenuation = 0.85
			first = false
	var probe := ReflectionProbe.new()
	probe.size = Vector3(r["w"] * LevelBuilder.CELL, h, r["d"] * LevelBuilder.CELL)
	probe.position = Vector3((r["x"] + r["w"] * 0.5) * LevelBuilder.CELL, r["y"] + h * 0.5, (r["z"] + r["d"] * 0.5) * LevelBuilder.CELL)
	probe.update_mode = ReflectionProbe.UPDATE_ONCE
	probe.box_projection = true
	probe.interior = true
	probe.ambient_mode = ReflectionProbe.AMBIENT_DISABLED
	probe.max_distance = 0.0
	add_child(probe)
	_probes.append(probe)

func _process(delta: float) -> void:
	_t += delta
	for f in _flicker:
		var l: Light3D = f[0]
		if not is_instance_valid(l):
			continue
		var n := sin(_t * 23.0 + f[3]) * sin(_t * 7.3 + f[3] * 2.0)
		var drop := 1.0
		if n > 1.0 - float(f[2]) * 0.6:
			drop = 0.08
		l.light_energy = float(f[1]) * drop

# ---------------------------------------------------------------- navigation
func bake_navigation() -> void:
	if nav == null:
		return
	# the navigation map outlives areas (one World3D): match it to THIS area's mesh voxels, or an interior loaded after
	# the exterior (0.5 m cells) would sit on a mismatched map
	var map := get_world_3d().navigation_map
	NavigationServer3D.map_set_cell_size(map, nav.navigation_mesh.cell_size)
	NavigationServer3D.map_set_cell_height(map, nav.navigation_mesh.cell_height)
	var src := NavigationMeshSourceGeometryData3D.new()
	NavigationServer3D.parse_source_geometry_data(nav.navigation_mesh, src, self)
	NavigationServer3D.bake_from_source_geometry_data(nav.navigation_mesh, src)
	nav.navigation_mesh = nav.navigation_mesh

# ---------------------------------------------------------------- checkpoints & helpers
func checkpoint(id: String, pos: Vector3, yaw_deg: float, zone_size: Vector3 = Vector3.ZERO) -> void:
	checkpoints[id] = Transform3D(Basis(Vector3.UP, deg_to_rad(yaw_deg)), pos)
	if zone_size != Vector3.ZERO:
		var z := Checkpoint.new()
		z.stable_id = id
		z.size = zone_size
		add_child(z)
		z.global_position = pos + Vector3.UP * zone_size.y * 0.5

func checkpoint_xform(id: String) -> Transform3D:
	if checkpoints.has(id):
		return checkpoints[id]
	if checkpoints.size() > 0:
		return checkpoints.values()[0]
	return Transform3D(Basis(), Vector3(0, 0.2, 0))

func add_entity(n: Node3D, pos: Vector3, yaw_deg: float = 0.0) -> Node3D:
	add_child(n)
	n.global_position = pos
	n.rotation.y = deg_to_rad(yaw_deg)
	return n

## Static prop from the environment kit (or a stand-in box), with box collision from its bounds.
func prop(name: String, pos: Vector3, yaw_deg: float = 0.0, collide: bool = true, scale: float = 1.0) -> Node3D:
	var p := Props.make(name, collide)
	add_child(p)
	p.global_position = pos
	p.rotation.y = deg_to_rad(yaw_deg)
	if scale != 1.0:
		p.scale = Vector3.ONE * scale
	return p

func enemy(kind: String, id: String, pos: Vector3, yaw_deg: float = 0.0, opts: Dictionary = {}) -> Node3D:
	if Game.flag("dead." + id):
		return null
	var e: EnemyBase = Enemies.make(kind)
	e.stable_id = id
	e.spawn_opts = opts
	add_child(e)
	e.global_position = pos
	e.rotation.y = deg_to_rad(yaw_deg)
	return e

func trigger(id: String, pos: Vector3, size: Vector3, on_enter: Callable, once: bool = true) -> TriggerZone:
	var t := TriggerZone.new()
	t.stable_id = id
	t.size = size
	t.once = once
	t.entered.connect(on_enter)
	add_child(t)
	t.global_position = pos + Vector3.UP * size.y * 0.5
	return t

## A sliding door in a kit door frame on the edge between `cell` and its neighbour in `dir`.
func door(id: String, cell: Vector2i, dir: String, opts: Dictionary = {}) -> Door:
	var p := B.open(cell, dir, "door")
	var d := Door.new()
	d.stable_id = id
	d.lock_flag = opts.get("lock", "")
	d.locked_text = opts.get("text", "Locked")
	d.keycard = opts.get("keycard", "")
	d.auto = opts.get("auto", true)
	d.stays_open = opts.get("stays_open", false)
	add_child(d)
	d.global_position = p
	d.rotation.y = 0.0 if dir in ["n", "s"] else PI * 0.5
	return d

## Floor-level world position at fractional cell coordinates (cell (2,3) centre = (2.5, 3.5) world/4).
func at(cx: float, cz: float, y: float = INF) -> Vector3:
	return B.cell_pos(cx - 0.5, cz - 0.5, y)

## An exit: walking into it loads another area (the PRD's level streaming boundary).
func exit_zone(id: String, pos: Vector3, size: Vector3, to_area: String, to_cp: String, requires: String = "") -> void:
	var t := trigger("exit." + id, pos, size, func(_p): GameMode.travel(to_area, to_cp), false)
	t.requires_flag = requires

func cover_point(pos: Vector3) -> void:
	var n := Marker3D.new()
	n.add_to_group("cover")
	add_child(n)
	n.global_position = pos

func log_at(id: int, pos: Vector3, yaw: float = 0.0, terminal: bool = false) -> LogPickup:
	var l := LogPickup.new()
	l.log_id = id
	l.terminal = terminal
	add_child(l)
	l.global_position = pos
	l.rotation.y = deg_to_rad(yaw)
	return l

func pickup(kind: String, id: String, pos: Vector3, amount: int = 1, extra: Dictionary = {}) -> Pickup:
	var p := Pickup.new()
	p.kind = kind
	p.stable_id = id
	p.amount = amount
	p.keycard_id = extra.get("keycard", "")
	p.label = extra.get("label", "")
	add_child(p)
	p.global_position = pos
	return p

func console(id: String, pos: Vector3, yaw: float, prompt_text: String, action: Callable, opts: Dictionary = {}) -> Console:
	var c := Console.new()
	c.stable_id = id
	c.prompt = prompt_text
	c.model_name = opts.get("model", "terminal")
	c.requires = opts.get("requires", "")
	c.requires_text = opts.get("requires_text", "No power")
	c.one_shot = opts.get("one_shot", true)
	c.focus_offset = opts.get("focus", Vector3(0, 1.2, 0.3))
	c.action = action
	add_child(c)
	c.global_position = pos
	c.rotation.y = deg_to_rad(yaw)
	return c

## Story beat helper: say a line once (saved), optionally after a delay.
func beat(flag_id: String, line: String, delay: float = 0.0) -> void:
	if Game.flag("said." + flag_id):
		return
	Game.set_flag("said." + flag_id)
	if delay > 0.0:
		await get_tree().create_timer(delay, false).timeout
	Sfx.say(line)

func label3d(text: String, pos: Vector3, yaw: float, size: int = 48, color: Color = Color(0.85, 0.92, 1.0)) -> Label3D:
	var l := Label3D.new()
	l.text = text
	l.font = UIKit.font("Rajdhani-Bold")
	l.font_size = size
	l.pixel_size = 0.004
	l.modulate = color
	l.outline_size = 0
	l.shaded = false
	add_child(l)
	l.global_position = pos
	l.rotation.y = deg_to_rad(yaw)
	return l
