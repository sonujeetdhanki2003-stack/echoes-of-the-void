[gd_resource type="Resource" script_class="MissionList" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/mission_list.gd" id="1"]

[resource]
script = ExtResource("1")
missions = Array[Dictionary]([{"id": "awakening", "code": "M01", "title": "01 — AWAKENING", "subtitle": "Escape the containment area and learn the controls.", "objectives": [{"id": "escape_bay", "text": "Get out of the cryo bay", "flag": "door.cryo_bay"}, {"id": "find_weapon", "text": "Find a weapon in the medbay", "flag": "got.pistol"}, {"id": "survive_first", "text": "Deal with the creature", "flag": "enc.cryo_first"}, {"id": "power", "text": "Restore emergency power in the generator room", "flag": "puzzle.generators"}, {"id": "to_research", "text": "Go through the bulkhead to the Research Wing", "flag": "area.research"}]}, {"id": "dead_signal", "code": "M02", "title": "02 — LOST RESEARCH", "subtitle": "Search the Research Wing, recover the classified research data and get through Security.", "objectives": [{"id": "research_data", "text": "Recover Dr. Iyer's research data from her office", "flag": "used.log.5"}, {"id": "find_security", "text": "Find a way into the Security Sector", "flag": "seen.security_gate"}, {"id": "code", "text": "Security access: find the override code and use the gate terminal", "flag": "puzzle.security_code"}, {"id": "armory", "text": "Get a weapon from the armory", "flag": "got.rifle"}, {"id": "comms", "text": "Restore communications in the comms room", "flag": "comms.restored"}]}, {"id": "experiment", "code": "M03", "title": "03 — CONTAINMENT FAILURE", "subtitle": "Restore the reactor systems and survive the organism.", "objectives": [{"id": "to_reactor", "text": "Take the cargo lift down to the Reactor Core", "flag": "area.reactor"}, {"id": "iyer_lab", "text": "Find Dr. Iyer's experiment lab", "flag": "seen.iyer_lab"}, {"id": "conduits", "text": "Stabilize the reactor: reroute power through the conduits", "flag": "puzzle.conduits"}, {"id": "survive", "text": "Survive until MIRA unlocks the lift", "flag": "enc.reactor_survive"}, {"id": "to_surface", "text": "Take the lift to the surface", "flag": "area.exterior"}]}, {"id": "last_transmission", "code": "M04", "title": "04 — FINAL EXTRACTION", "subtitle": "Reach the extraction zone, confront the final threat and escape.", "objectives": [{"id": "cross", "text": "Cross the crystal fields to the launch pad", "flag": "area.extraction"}, {"id": "transmit", "text": "Send the warning from the pad's comms console", "flag": "transmission.sent"}, {"id": "boss", "text": "Defeat the Herald", "flag": "boss.dead"}, {"id": "board", "text": "Board the shuttle", "flag": "game.complete"}]}])
